{
  "name": "decentralized-cab-app",
  "version": "1.0.0",
  "description": "Hyperledger Fabric based cab booking application with carpooling",
  "main": "index.js",
  "scripts": {
    "setup": "npm run setup:network && npm run setup:backend && npm run setup:frontend",
    "setup:network": "cd network && ./network.sh up createChannel -c ridechannel -ca",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "deploy:chaincode": "cd network && ./network.sh deployCC -ccn ridecontract -ccp ../chaincode -ccl go",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "clean": "cd network && ./network.sh down"
  },
  "keywords": [
    "hyperledger-fabric",
    "blockchain",
    "cab-booking",
    "carpooling",
    "ipfs",
    "decentralized"
  ],
  "author": "Your Name",
  "license": "MIT"
}
