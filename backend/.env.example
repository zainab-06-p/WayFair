PORT=5000
NODE_ENV=development

# Hyperledger Fabric
CHANNEL_NAME=ridechannel
CHAINCODE_NAME=ridecontract
MSP_ID=Org1MSP
PEER_ENDPOINT=localhost:7051
ORDERER_ENDPOINT=localhost:7050

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# Ethereum
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
PAYMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Email Configuration
# ==================
# Choose ONE of the following methods:

# Method 1: Google OAuth2 (RECOMMENDED for production)
# Get these from: https://console.cloud.google.com/
# Follow guide: See GOOGLE_OAUTH_QUICK.md
EMAIL_USER=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REFRESH_TOKEN=1//0your_refresh_token

# Method 2: Gmail App Password (Simple, for testing)
# Uncomment these and comment out OAuth2 fields above:
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_app_password

# Email From Address (optional)
EMAIL_FROM=RideShare <noreply@rideshare.com>
EMAIL_SERVICE=gmail

# n8n Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ride-notifications

# JWT Secret
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# Security
SALT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database paths
WALLET_PATH=./wallet
CONNECTION_PROFILE_PATH=../network/organizations/peerOrganizations/org1.rideshare.com/connection-org1.json
