# Dependencies
node_modules/
*/node_modules/

# Environment variables (NEVER commit these)
backend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Build outputs
frontend/build/
frontend/.cache/

# Logs
*.log
backend/server.log
backend/startup.log
backend/startup-err.log
backend/test-output.txt

# Local data stores (regenerated at runtime)
backend/local-data.json
backend/local-payments.json
backend/local-referrals.json

# Wallet files (sensitive crypto material)
backend/wallet/
network/organizations/peerOrganizations/
network/organizations/ordererOrganizations/
network/channel-artifacts/

# Compiled chaincode binary
chaincode/rideshare-chaincode.exe
chaincode/rideshare-chaincode

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp

# Test files
backend/test-quick.js
backend/test-fabric-check.js

# Uploads (user files — should be on IPFS)
backend/uploads/*
!backend/uploads/.gitkeep
